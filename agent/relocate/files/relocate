#!/bin/bash
# relocate: мастер переезда узла на новый IP после клонирования у хостера.
# Запусти на клоне (на сервере доступна и под именем relocate-ИМЯ_УЗЛА). Он сам найдёт старые адреса
# в настройках, спросит новые (по умолчанию берёт то, что сейчас на сетевом интерфейсе), покажет, что
# изменится, и после подтверждения применит через vpnkit-reip. Ключ -y — без вопросов подтверждения
# (адреса берутся из значений по умолчанию или из переменных NEW_SELF, NEW_GW, NEW_PEER).
set -u
YES=0; [ "${1:-}" = "-y" ] && YES=1
. /etc/vpnkit/relocate.conf 2>/dev/null || { echo "нет /etc/vpnkit/relocate.conf — модуль relocate не установлен"; exit 1; }
: "${NODE:=узел}" "${ROLE:=}" "${DOMAIN:=}" "${PEER_NAME:=}"  # пишет Крот при установке
case "$ROLE" in
  entry) PEER_KEY=EXIT_IP;;
  exit) PEER_KEY=PEER_PUBLIC;;
  *) PEER_KEY="";;
esac
W=/etc/vpnkit/watch.conf
DEV=$(ip -4 route show default | awk '{for(i=1;i<NF;i++) if($i=="dev") {print $(i+1); exit}}')
cfg_self=$(awk '$1=="address"{sub("/.*","",$2); print $2}' /etc/network/interfaces | head -1)
cfg_gw=$(awk '$1=="gateway"{print $2}' /etc/network/interfaces | head -1)
cfg_peer=""; [ -n "$PEER_KEY" ] && cfg_peer=$(awk -F= -v k=$PEER_KEY '$1==k{print $2}' $W 2>/dev/null)
live_self=$(ip -4 -br a show "$DEV" | awk '{sub("/.*","",$3); print $3}')
live_gw=$(ip -4 route show default | awk '{for(i=1;i<NF;i++) if($i=="via") {print $(i+1); exit}}')
echo "== переезд $NODE =="
echo "в настройках:  адрес $cfg_self, шлюз $cfg_gw${PEER_NAME:+, $PEER_NAME $cfg_peer}"
echo "сейчас на $DEV: адрес ${live_self:-?}, шлюз ${live_gw:-?}"
ask() { # ask "вопрос" "по умолчанию" переменная-окружения
  local v="${!3:-}"
  if [ -z "$v" ]; then
    if [ $YES = 1 ]; then v=$2; else read -r -p "$1 [$2]: " v; v=${v:-$2}; fi
  fi
  [[ $v =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || { echo "не похоже на IPv4: $v" >&2; exit 2; }
  echo "$v"
}
new_self=$(ask "Новый адрес $NODE" "${live_self:-$cfg_self}" NEW_SELF) || exit 2
new_gw=$(ask "Новый шлюз" "${live_gw:-$cfg_gw}" NEW_GW) || exit 2
new_peer="$cfg_peer"; [ -n "$cfg_peer" ] && { new_peer=$(ask "Новый адрес $PEER_NAME (Enter — не менялся)" "$cfg_peer" NEW_PEER) || exit 2; }
MAPS=(); PEERMAPS=()
[ "$new_self" != "$cfg_self" ] && { MAPS+=(--map "$cfg_self" "$new_self"); PEERMAPS+=(--map "$cfg_self" "$new_self"); }
[ "$new_gw" != "$cfg_gw" ] && MAPS+=(--map "$cfg_gw" "$new_gw")
[ -n "$cfg_peer" ] && [ "$new_peer" != "$cfg_peer" ] && { MAPS+=(--map "$cfg_peer" "$new_peer"); PEERMAPS+=(--map "$cfg_peer" "$new_peer"); }
[ ${#MAPS[@]} -gt 0 ] || { echo "Адреса не менялись — делать нечего."; exit 0; }
echo; echo "-- что будет изменено:"
/usr/local/sbin/vpnkit-reip "${MAPS[@]}"
if [ $YES = 0 ]; then read -r -p "Применить? [y/N]: " a; [ "$a" = y ] || [ "$a" = Y ] || { echo "отменено"; exit 0; }; fi
/usr/local/sbin/vpnkit-reip "${MAPS[@]}" --apply
if [ ${#PEERMAPS[@]} -gt 0 ] && [ -n "$PEER_NAME" ]; then
  echo; echo "-- сосед $PEER_NAME: ему нужны те же замены адресов"
  tun=$(awk -F= '$1=="PEER_TUN"{print $2}' $W)
  ok=0
  for t in "$tun" "$new_peer"; do
    [ -n "$t" ] || continue
    if ssh -o BatchMode=yes -o ConnectTimeout=6 "root@$t" true 2>/dev/null; then
      if [ $YES = 1 ] || { read -r -p "Применить и на $PEER_NAME ($t)? [y/N]: " a; [ "$a" = y ] || [ "$a" = Y ]; }; then
        ssh -o BatchMode=yes "root@$t" /usr/local/sbin/vpnkit-reip "${PEERMAPS[@]}" --apply && ok=1
      fi
      break
    fi
  done
  [ $ok = 1 ] || echo "Не выполнено автоматически. На $PEER_NAME запусти:  vpnkit-reip ${PEERMAPS[*]} --apply   (или relocate на нём)"
fi
echo
echo "Осталось:"
echo " 1) у регистратора направить на $new_self записи домена ${DOMAIN:-узла} (и его поддоменов, смотрящих на этот сервер)"
[ "$new_self" != "$live_self" ] && echo " 2) сеть пока не перенастроена: на $DEV сейчас ${live_self:-?}, перезагрузи сервер (reboot)"
[ "$new_self" = "$live_self" ] && echo " 2) адрес на $DEV уже совпадает с настройками; перезагрузка не обязательна"
